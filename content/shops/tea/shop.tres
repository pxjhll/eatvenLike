[sub_resource type="Resource" id="Resource_j7ryq"]
script = ExtResource("12_anqca")
id = "kitchen"
when = Array[String](["stage>=1", "kitchen_staff:0", "no_box", "can_staff"])
done_when = Array[String](["!kitchen_staff:0"])
cues = Array[Dictionary]([{
"at": "ui:tab:staff",
"if": ["waiting", "!page:staff"],
"text": "后厨还没人！新伙伴在名册里，点「员工」"
}, {
"at": "ui:deploy",
"if": ["waiting"],
"select_waiting": true,
"text": "点「派到店内」，让伙伴去后厨煮茶"
}, {
"back": true,
"if": ["!can_hire"]
}, {
"at": "ui:tab:staff",
"if": ["!page:staff"],
"text": "前台只管接待客人，煮茶要后厨员工：点「员工」"
}, {
"at": "ui:hire",
"text": "招一位伙伴，招来直接去后厨"
}])

[sub_resource type="Resource" id="Resource_l8d5n"]
script = ExtResource("12_anqca")
id = "more_staff"
when = Array[String](["stage>=5", "room", "can_staff"])
done_when = Array[String](["hired", "!room"])
cues = Array[Dictionary]([{
