[sub_resource type="Resource" id="Resource_4p3jx"]
script = ExtResource("12_anqca")
id = "welcome"
when = Array[String](["!open"])
seen_when = Array[String](["open", "stage>=1"])
shop_page_only = false
skip_marks = Array[String](["opening"])
style = "card"
title = "欢迎，店长！"
art = "raccoon"
rows = [["lemonade", "招待顾客，卖饮品收金币"], ["boil", "开通后厨生产线，做新饮品"], ["goals", "完成经营任务，把小店做大"]]
confirm_label = "开始营业"
cancel_label = "跳过引导"
next = "opening"

[sub_resource type="Resource" id="Resource_1wmsa"]
script = ExtResource("12_anqca")
id = "opening"
seen_when = Array[String](["stage>=1", "open&staff>=opening"])
shop_page_only = false
cues = Array[Dictionary]([{
"at": "ui:unlock",
"if": ["!open", "page:station:lemonade"],
"text": "点「解锁」，花 10 金币摆上柠檬水台"
}, {
"go": "shop",
"if": ["!open", "!page:shop"]
}, {
"at": "frame:lemonade",
"if": ["!open"],
"text": "先开张！点这里摆上柠檬水台"
}, {
"at": "area:Guide/CounterArea",
"if": ["sold:0"],
"pause": false,
"text": "小猫会自己做柠檬水、招呼客人。
看看第一杯卖出去！"
}, {
"at": "ui:tab:staff",
"if": ["staff<opening", "waiting", "!page:staff"],
"text": "新伙伴在名册里，点「员工」"
}, {
"at": "ui:deploy",
"if": ["staff<opening", "waiting"],
"select_waiting": true,
"text": "点「派到店内」，让伙伴一起干活"
}, {
"if": ["staff<opening", "!can_hire"],
"wait": true
}, {
"at": "ui:tab:staff",
"if": ["staff<opening", "!page:staff"],
"text": "收到金币了！人手多出杯更快，点「员工」"
}, {
"at": "ui:hire",
"if": ["staff<opening"],
"text": "招一位新伙伴，招来直接上岗"
}, {
"then": "done"
}])
skip_label = "跳过引导"
skip_marks = Array[String](["welcome"])

[sub_resource type="Resource" id="Resource_ho7ym"]
script = ExtResource("12_anqca")
id = "done"
trigger = "next"
params = {
"stage": 1
}
finish_marks = Array[String](["opening"])
style = "card"
title = "开店上手了！"
text = "接下来自己经营：攒够 {cost} 金币，就能开{line}。
点机器可以升级，点「员工」可以调整岗位。"
confirm_label = "继续营业"

[sub_resource type="Resource" id="Resource_tsvuk"]
script = ExtResource("12_anqca")
id = "line_1"
when = Array[String](["stage>=0", "stage<1", "affordable:boil"])
done_when = Array[String](["stage>=1", "!affordable:boil"])
cues = Array[Dictionary]([{
"at": "ui:unlock",
"if": ["page:station:boil"],
"text": "点「解锁」开通{line}"
}, {
"go": "shop",
"if": ["!page:shop"]
}, {
"at": "frame:boil",
"text": "金币够了！开通{line}，能卖新饮品"
}])
params = {
"stage": 1
}

[sub_resource type="Resource" id="Resource_njies"]
script = ExtResource("12_anqca")
