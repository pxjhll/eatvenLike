"if": ["waiting", "!page:staff"],
"text": "加料机开通了，每杯要多走一段路。
还有空岗位，点「员工」派伙伴上岗"
}, {
"at": "ui:deploy",
"if": ["waiting"],
"select_waiting": true,
"text": "点「派到店内」，让伙伴一起干活"
}, {
"back": true,
"if": ["!can_hire"]
}, {
"at": "ui:tab:staff",
"if": ["!page:staff"],
"text": "加料机开通了，每杯要多走一段路。
还有空岗位，点「员工」再招一位，
煮茶机也要升级跟上"
}, {
"at": "ui:hire",
"text": "招一位新伙伴，招来直接上岗"
}])

