[sub_resource type="Resource" id="Resource_3rjv3"]
script = ExtResource("12_p70m1")
id = "welcome"
when = Array[String](["!open"])
seen_when = Array[String](["open"])
shop_page_only = false
skip_marks = Array[String](["opening", "hire", "done"])
style = "card"
title = "欢迎来到煎饼果子摊"
text = "早点摊刚支起来，先卖豆浆，攒钱再开鏊子、油锅和加料台。
员工会自己接单，从收钱一直做到递餐。"
confirm_label = "开始"
cancel_label = "跳过引导"
next = "opening"

[sub_resource type="Resource" id="Resource_2y8k5"]
script = ExtResource("12_p70m1")
id = "opening"
done_when = Array[String](["!sold:0"])
seen_when = Array[String](["stage>=1"])
shop_page_only = false
cues = Array[Dictionary]([{
"at": "ui:unlock",
"if": ["!open", "page:station:soy_milk"],
"text": "点「解锁」，花 10 金币开张"
}, {
"go": "shop",
"if": ["!open", "!page:shop"]
}, {
"at": "frame:soy_milk",
"if": ["!open"],
"text": "点豆浆机，花 10 金币开张"
}, {
"at": "station:front_counter",
"pause": false,
"text": "员工去前台收钱、打豆浆。
看第一单卖出去"
}])
skip_label = "跳过引导"
skip_marks = Array[String](["welcome"])

[sub_resource type="Resource" id="Resource_f53vs"]
script = ExtResource("12_p70m1")
id = "hire"
when = Array[String](["stage>=1", "staff<2", "can_hire"])
done_when = Array[String](["hired", "!room"])
seen_when = Array[String](["staff>=2"])
cues = Array[Dictionary]([{
"at": "ui:tab:staff",
"if": ["!page:staff"],
"text": "一个人又收钱又摊饼，忙不过来了。
点「员工」招第二个人"
}, {
"at": "ui:hire",
"text": "一个人又收钱又摊饼，忙不过来了。
招第二个人"
}])

[sub_resource type="Resource" id="Resource_wn2x6"]
script = ExtResource("12_p70m1")
id = "done"
when = Array[String](["seen:hire"])
style = "card"
title = "开张完成"
text = "之后每分钟回来看一眼就行：
攒够钱开下一台；队伍排满了就招人；台子上出现红色 ↑ 就点它升级。"

