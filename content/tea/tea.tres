[sub_resource type="Resource" id="station_supply_cabinet"]
script = ExtResource("station_def")
id = "supply_cabinet"
display_name = "原料柜"
mode = 3
zone = "kitchen"
output_capacity = 3
supply_interval = 1.0
supply_items = Array[String](["tea_leaf", "milk"])
price = 60
footprint = Vector2i(2, 1)
ports = Array[ExtResource("port_def")]([SubResource("port_cabinet_out")])
wall_only = true

[sub_resource type="Resource" id="station_tea_brewer"]
script = ExtResource("station_def")
id = "tea_brewer"
display_name = "煮茶机"
mode = 0
zone = "kitchen"
recipe = SubResource("recipe_brew_tea")
cycle_seconds = 12.0
input_capacity = Dictionary[String, int]({"tea_leaf": 2})
output_capacity = 8
level_speed = Array[float]([1.0, 1.15, 1.32, 1.52, 1.75, 2.01, 2.31, 2.66, 3.06, 3.52])
upgrade_costs = Array[int]([40, 60, 90, 135, 203, 304, 456, 684, 1026])
price = 60
footprint = Vector2i(2, 2)
ports = Array[ExtResource("port_def")]([SubResource("port_brewer_in"), SubResource("port_brewer_out")])

[sub_resource type="Resource" id="station_milk_station"]
script = ExtResource("station_def")
id = "milk_station"
display_name = "调奶台"
mode = 2
zone = "kitchen"
recipe = SubResource("recipe_mix_milk_tea")
cycle_seconds = 4.0
input_capacity = Dictionary[String, int]({"tea_soup": 3, "milk": 3})
output_capacity = 3
level_speed = Array[float]([1.0, 1.15, 1.32, 1.52, 1.75, 2.01, 2.31, 2.66, 3.06, 3.52])
upgrade_costs = Array[int]([40, 60, 90, 135, 203, 304, 456, 684, 1026])
price = 60
footprint = Vector2i(2, 1)
ports = Array[ExtResource("port_def")]([SubResource("port_milk_in_tea"), SubResource("port_milk_in_milk"), SubResource("port_milk_out")])
work_cell = Vector2i(1, -1)

[sub_resource type="Resource" id="station_topping"]
script = ExtResource("station_def")
