[sub_resource type="Resource" id="task_tea20"]
script = ExtResource("task_def")
id = "tea20"
display_name = "珍珠奶茶卖出 20 杯"
target_id = "pearl_milk_tea"
amount = 20.0

[sub_resource type="Resource" id="stage_lemon"]
script = ExtResource("shop_stage_def")
dish_id = "lemonade"
customer_interval = 4.0
order_weights = Dictionary[String, float]({"lemonade": 1.0})
tasks = Array[ExtResource("task_def")]([SubResource("task_lemon30")])

[sub_resource type="Resource" id="stage_tea"]
script = ExtResource("shop_stage_def")
dish_id = "pearl_milk_tea"
revenue_threshold = 300
kitchen_devices = Array[String](["supply_cabinet", "tea_brewer", "milk_station", "topping_station"])
customer_interval = 2.0
order_weights = Dictionary[String, float]({"lemonade": 0.25, "pearl_milk_tea": 0.75})
tasks = Array[ExtResource("task_def")]([SubResource("task_tea20")])

[sub_resource type="Resource" id="progression"]
script = ExtResource("shop_progression_def")
stages = Array[ExtResource("shop_stage_def")]([SubResource("stage_lemon"), SubResource("stage_tea")])

[resource]
script = ExtResource("shop_config")
id = "tea"
display_name = "奶茶店"
items = Array[ExtResource("item_def")]([SubResource("item_tea_leaf"), SubResource("item_milk"), SubResource("item_tea_soup"), SubResource("item_milk_tea"), SubResource("item_lemonade"), SubResource("item_pearl_milk_tea")])
dishes = Array[ExtResource("dish_def")]([SubResource("dish_lemonade"), SubResource("dish_pearl_milk_tea")])
kitchen_devices = Array[ExtResource("station_def")]([SubResource("station_supply_cabinet"), SubResource("station_tea_brewer"), SubResource("station_milk_station"), SubResource("station_topping")])
supply_slot_limit = 4
belt_speed = 3.0
starting_gold = 50
front_spots = Array[ExtResource("front_spot_def")]([SubResource("spot_lemonade_stand"), SubResource("spot_counter")])
hire_costs = Array[int]([15, 25, 40, 60])
hire_defs = Array[ExtResource("staff_def")]([ExtResource("staff_rabbit"), ExtResource("staff_bear"), ExtResource("staff_cat")])
hires_own_staff = true
grid = ExtResource("tea_grid")
shelf_capacity = 12
queue_capacity = 6
customer_patience = 24.0
arrival_jitter = 0.15
progression = SubResource("progression")
random_seed = 20261025
