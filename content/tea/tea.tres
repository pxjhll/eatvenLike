[resource]
script = ExtResource("shop_config")
id = "tea"
display_name = "奶茶店"
kitchen_unlock_stage = 1
items = Array[ExtResource("item_def")]([SubResource("item_tea_leaf"), SubResource("item_milk"), SubResource("item_tea"), SubResource("item_plain_milk_tea"), SubResource("item_pearl_milk_tea"), SubResource("item_coconut_milk_tea"), SubResource("item_redbean_milk_tea"), SubResource("item_taro_milk_tea"), SubResource("item_lemonade")])
dishes = Array[ExtResource("dish_def")]([SubResource("dish_lemonade"), SubResource("dish_plain_milk_tea"), SubResource("dish_pearl_milk_tea"), SubResource("dish_coconut_milk_tea"), SubResource("dish_redbean_milk_tea"), SubResource("dish_taro_milk_tea")])
slots = Array[ExtResource("slot_def")]([SubResource("slot_cabinet"), SubResource("slot_brewer"), SubResource("slot_milk_station"), SubResource("slot_topping")])
connections = Array[ExtResource("connection_def")]([SubResource("conn_cabinet_to_brewer"), SubResource("conn_cabinet_to_milk"), SubResource("conn_brewer_to_milk"), SubResource("conn_milk_to_shelf"), SubResource("conn_milk_to_topping"), SubResource("conn_topping_to_shelf")])
belt_speed = 3.0
zones = Array[String](["front", "kitchen"])
walk_seconds = Dictionary[String, float]({"front>kitchen": 2.0})
starting_gold = 50
front_spots = Array[ExtResource("front_spot_def")]([SubResource("spot_lemonade_stand"), SubResource("spot_counter")])
hire_costs = Array[int]([15, 25, 40, 60])
hire_defs = Array[ExtResource("staff_def")]([ExtResource("staff_rabbit"), ExtResource("staff_bear"), ExtResource("staff_cat")])
hires_own_staff = true
grid = ExtResource("tea_grid")
shelf_capacity = 12
queue_capacity = 6
customer_patience = 24.0
arrival_jitter = 0.15
progression = SubResource("progression")
random_seed = 20261025
