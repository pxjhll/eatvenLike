[resource]
script = ExtResource("shop_progression_def")
stages = Array[ExtResource("shop_stage_def")]([SubResource("stage_lemon"), SubResource("stage_black_tea"), SubResource("stage_milk_tea"), SubResource("stage_topping")])
belts = Array[ExtResource("belt_slot_def")]([SubResource("belt_seal_to_shelf"), SubResource("belt_supply_to_boil"), SubResource("belt_boil_to_seal"), SubResource("belt_boil_to_mix"), SubResource("belt_mix_to_seal"), SubResource("belt_mix_to_topping"), SubResource("belt_topping_to_seal")])
