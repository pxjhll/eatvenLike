[gd_resource type="Resource" script_class="SpecCampaign" format=3]

[ext_resource type="Script" path="res://content/rules/spec_campaign.gd" id="campaign"]
[ext_resource type="Script" path="res://content/rules/spec_city.gd" id="city"]
[ext_resource type="Script" path="res://content/rules/spec_campaign_shop.gd" id="shop"]

[sub_resource type="Resource" id="DemoShop"]
script = ExtResource("shop")
id = "module_demo"
display_name = "Template Demo"
shop_path = "res://tests/fixtures/onboarding/shop.tres"

[sub_resource type="Resource" id="DemoCity"]
script = ExtResource("city")
id = "demo_city"
display_name = "Demo City"
shops = Array[ExtResource("shop")]([SubResource("DemoShop")])

[resource]
script = ExtResource("campaign")
cities = Array[ExtResource("city")]([SubResource("DemoCity")])
